# Copy this file to .env for local Docker Compose runs and replace every placeholder.
# Never commit .env (it is ignored by git and .dockerignore).

# Shared by every service. Use at least 32 random characters for JWT_SECRET.
JWT_SECRET=replace-with-a-long-random-value-at-least-32-characters
INTERNAL_API_KEY=replace-with-a-separate-long-random-value
JWT_ISSUER=ECommerce
JWT_AUDIENCE=ECommerce.Client

# Origin used by the browser when the storefront is served by Docker Compose.
FRONTEND_ORIGIN=http://localhost:3000

# Optional administrator account created in the User Service on first start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional Microsoft Foundry / Azure OpenAI configuration. Leave blank to use the
# deterministic recommendation, search and chatbot fallbacks.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_CHAT_DEPLOYMENT=
FOUNDRY_API_VERSION=2024-10-21
FOUNDRY_MODE=auto
