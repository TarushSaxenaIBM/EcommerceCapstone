{
  "ConnectionStrings": {
    "OrderDb": "Data Source=data/order.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrations": true
  },
  "Services": {
    "ProductServiceUrl": "http://localhost:5101/"
  },
  "Orders": {
    "AutoProcessAfterMinutes": 2,
    "AutoProcessIntervalSeconds": 60
  },
  "Jwt": {
    "Issuer": "ECommerce",
    "Audience": "ECommerce.Client",
    "ExpiryMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:4173"
    ]
  },
  "Foundry": {
    "Endpoint": "",
    "ApiKey": "",
    "ChatDeployment": "",
    "Mode": "auto",
    "ApiVersion": "2024-10-21",
    "TimeoutSeconds": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
