@ECommerce.API_HostAddress = http://localhost:5080

### Register
POST {{ECommerce.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Test",
  "lastName": "User",
  "email": "test@example.com",
  "password": "Password123!"
}

### Login
POST {{ECommerce.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123!"
}

### Products
GET {{ECommerce.API_HostAddress}}/api/products?page=1&pageSize=12

### Categories
GET {{ECommerce.API_HostAddress}}/api/categories
